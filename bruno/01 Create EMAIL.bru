meta {
  name: Create EMAIL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}
  body: json
  auth: none
}

body:json {
  {
    "recipient": "jan.kowalski@example.com",
    "content": "Testowe powiadomienie email",
    "channel": "EMAIL",
    "priority": "HIGH",
    "timeZone": "Europe/Warsaw",
    "scheduledAt": "2026-12-01T10:00:00"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("notificationId", res.body.id);
  }
}

tests {
  test("status 201", () => expect(res.status).to.equal(201));
  test("ma id", () => expect(res.body.id).to.be.a("number"));
}
